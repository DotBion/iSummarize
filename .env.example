# Copy to .env and fill in only what you use.

# --- Speech to text ---
# openai (default) | groq | elevenlabs | whisper
STT_PROVIDER=openai
STT_DIARIZE=true
LANGUAGE=en

# openai: diarize → gpt-4o-transcribe-diarize, else gpt-transcribe
# OPENAI_STT_MODEL=

# groq: free Whisper (no speakers) + free notes
# GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_MODEL=llama-3.3-70b-versatile

# local whisper fallback only (uses SSD)
WHISPER_MODEL=base

# --- Notes ---
# groq (default) | ollama | openai | anthropic | gemini | freellmapi
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# FreeLLMAPI local proxy
# FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto

# ELEVENLABS_API_KEY=

# Where transcripts + notes go (not inside this repo, not inside Voice Recorder)
# Mac folder:
OUTPUT_DIR=/Users/dotbion/Documents/MeetingNotes
# Or iCloud Drive (then they show up on the iPhone in Files):
# OUTPUT_DIR=/Users/dotbion/Library/Mobile Documents/com~apple~CloudDocs/MeetingNotes

# Voice Recorder iCloud folder (do not move files out of this)
# WATCH_DIR=/Users/dotbion/Library/Mobile Documents/iCloud~com~TapMediaLtd~VoiceRecorderFREE
